# Copy to .env and adjust. Every value is optional — an empty file is a working configuration.

# Password gate for the whole app. Unset = no login (fine on a private LAN).
#BRICKSEEKER_PASSWORD=change-me

# Encrypts stored Rebrickable / Brickset / BrickLink credentials. Generated into
# /data/secret.key on first run when unset. Changing it makes stored credentials unreadable
# (the app then asks for them again) — pin it before you rely on backups.
#BRICKSEEKER_SECRET_KEY=

# Where the SQLite database, image cache and catalogue snapshots live.
#BRICKSEEKER_DATA_DIR=/data

# Headless-browser price sources (lego.com, Amazon, Cdiscount). false = never launch Chromium.
#BRICKSEEKER_SCRAPING_ENABLED=true
#BRICKSEEKER_SCRAPE_TIMEOUT_SECONDS=30

# CDP WebSocket of an external Chromium, e.g. ws://chromium:3000. docker-compose.yml already sets
# this for its bundled `chromium` service, so leave it unset there. Only needed here if you run
# the backend outside that compose file (bare `docker run`, or `uvicorn --reload` against a
# Chromium you're not launching locally) and still want the browser-based price sources.
#BRICKSEEKER_BROWSER_WS_ENDPOINT=

# Background price refresh for sets carrying an enabled alert.
#BRICKSEEKER_BACKGROUND_REFRESH_ENABLED=true
#BRICKSEEKER_BACKGROUND_REFRESH_INTERVAL_MINUTES=60
#BRICKSEEKER_BACKGROUND_REFRESH_BATCH_SIZE=8

# Server-side OCR (tesseract) for camera/photo scanning.
#BRICKSEEKER_OCR_ENABLED=true
#BRICKSEEKER_OCR_LANGUAGES=eng+fra

# Extra CORS origins, comma-separated — only needed to point a Vite dev server at a container.
#BRICKSEEKER_CORS_ORIGINS=http://localhost:5173

#BRICKSEEKER_LOG_LEVEL=INFO
